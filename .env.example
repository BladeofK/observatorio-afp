# Copia este archivo como .env para ejecutar en local.
GCP_PROJECT=observatorio-afp-xxxx
BQ_LOCATION=US
BUCKET=observatorio-afp-xxxx-datos

# Tope por consulta (bytes). 104857600 = 100 MiB.
MAX_BYTES_BILLED=104857600

# API key de Gemini creada en AI Studio, en un proyecto SIN facturación.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_POR_MINUTO_IP=5
LLM_MAX_DIARIO=200
